    { "source": "/api/query", "destination": "https://nexora-backend.onrender.com/api/ai-shopping/query" },
    { "source": "/query", "destination": "https://nexora-backend.onrender.com/api/ai-shopping/query" },
    { "source": "/api/:path*", "destination": "https://nexora-backend.onrender.com/api/:path*" },
